\begin_layout Standard
Gravity gradient torque
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\boldsymbol{\tau}_{gg}=\frac{2\mu_{E}}{\left\Vert \boldsymbol{r}\right\Vert ^{3}}\left[\hat{\boldsymbol{r}}^{B}\times\right]\left(J\hat{\boldsymbol{r}}^{B}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
notes that 
\begin_inset Formula $\left\Vert \boldsymbol{r}\right\Vert =\left\Vert \boldsymbol{r}\right\Vert _{2}=\sqrt{\boldsymbol{r}^{T}\boldsymbol{r}}=$
\end_inset

.
 
\end_layout

\begin_layout Standard
\begin_inset Formula $\hat{\boldsymbol{r}}^{B}=R_{I}^{B}\hat{\boldsymbol{r}}^{I}=R_{I}^{B}\frac{\boldsymbol{r}_{I\to B}^{I}}{\left\Vert \boldsymbol{r}\right\Vert }$
\end_inset


\end_layout

\begin_layout Standard
and in terms of the attitude error states 
\begin_inset Formula $\delta\boldsymbol{\alpha}_{\hat{B}\to B}=\delta\boldsymbol{\alpha}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{d}{d\delta\boldsymbol{\alpha}}\left(\boldsymbol{\tau}_{gg}\right) & =\frac{2\mu_{E}}{\left\Vert \boldsymbol{r}\right\Vert ^{3}}\frac{d}{d\delta\boldsymbol{\alpha}}\left[\left(I-\delta\boldsymbol{\alpha}\times\right)\left(R_{I}^{\hat{B}}\right)\left(\hat{\boldsymbol{r}}^{I}\right)\right]\times\left[J\left(I-\delta\boldsymbol{\alpha}\times\right)\left(R_{I}^{\hat{B}}\right)\left(\hat{\boldsymbol{r}}^{I}\right)\right]\\
 & =\frac{2\mu_{E}}{\left\Vert \boldsymbol{r}\right\Vert ^{3}}\frac{d}{d\delta\boldsymbol{\alpha}}\left[\left(R_{I}^{\hat{B}}\right)\left(\hat{\boldsymbol{r}}^{I}\right)-\left(\delta\boldsymbol{\alpha}\times\right)\left(R_{I}^{\hat{B}}\right)\left(\hat{\boldsymbol{r}}^{I}\right)\right]\times\left[J\left(R_{I}^{\hat{B}}\right)\left(\hat{\boldsymbol{r}}^{I}\right)-J\left(\delta\boldsymbol{\alpha}\times\right)\left(R_{I}^{\hat{B}}\right)\left(\hat{\boldsymbol{r}}^{I}\right)\right]\\
 & =\frac{2\mu_{E}}{\left\Vert \boldsymbol{r}\right\Vert ^{3}}\frac{d}{d\delta\boldsymbol{\alpha}}\left\{ \left[-\left(R_{I}^{\hat{B}}\right)\left(\hat{\boldsymbol{r}}^{I}\right)\right]\times\left[J\left(\delta\boldsymbol{\alpha}\times\right)\left(R_{I}^{\hat{B}}\right)\left(\hat{\boldsymbol{r}}^{I}\right)\right]-\left[\left(\delta\boldsymbol{\alpha}\times\right)\left(R_{I}^{\hat{B}}\right)\left(\hat{\boldsymbol{r}}^{I}\right)\right]\times\left[J\left(R_{I}^{\hat{B}}\right)\left(\hat{\boldsymbol{r}}^{I}\right)\right]\right\} \\
 & =\frac{2\mu_{E}}{\left\Vert \boldsymbol{r}\right\Vert ^{3}}\frac{d}{d\delta\boldsymbol{\alpha}}\left\{ \left[-\left(R_{I}^{\hat{B}}\right)\left(\hat{\boldsymbol{r}}^{I}\right)\right]\times\left[J\left(\delta\boldsymbol{\alpha}\times\right)\left(R_{I}^{\hat{B}}\right)\left(\hat{\boldsymbol{r}}^{I}\right)\right]-\left[\left(\delta\boldsymbol{\alpha}\times\right)\left(R_{I}^{\hat{B}}\right)\left(\hat{\boldsymbol{r}}^{I}\right)\right]\times\left[J\left(R_{I}^{\hat{B}}\right)\left(\hat{\boldsymbol{r}}^{I}\right)\right]\right\} 
\end{align*}

\end_inset


